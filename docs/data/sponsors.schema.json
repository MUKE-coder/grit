{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grit sponsors",
  "description": "The sponsor roster rendered on /sponsors, the home strip, and the docs CTA. Hand-edited when someone sponsors; a sync script can write it later.",
  "type": "object",
  "required": ["lastSync", "sponsors"],
  "properties": {
    "$schema": { "type": "string" },
    "lastSync": {
      "type": "string",
      "description": "YYYY-MM-DD. Shown as LAST_SYNC on /sponsors.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sponsors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "tier", "since"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "Display name, e.g. \"Neon\" or \"Jane Doe\"." },
          "tier": {
            "enum": ["supporter", "backer", "special", "partner"],
            "description": "Must match a tier id in config/sponsors.ts."
          },
          "since": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$",
            "description": "YYYY-MM. Rendered as \"SINCE JUL 2026\"."
          },
          "interval": {
            "enum": ["month", "once"],
            "default": "month",
            "description": "Recurring or one-time. Drives \"$100 a month\" vs \"$500 one time\"."
          },
          "amount": {
            "type": "number",
            "description": "USD per interval. Defaults to the tier's monthly price."
          },
          "lifetime": {
            "type": "number",
            "description": "Total USD contributed to date. Powers LIFETIME FUNDING."
          },
          "avatar": { "type": "string", "description": "Logo/avatar URL or /public path. Falls back to a monogram." },
          "github": { "type": "string", "description": "GitHub login, without the @." },
          "website": { "type": "string", "description": "Bare host or full URL." },
          "past": { "type": "boolean", "default": false, "description": "No longer active; counted in all-time only." }
        }
      }
    }
  }
}
