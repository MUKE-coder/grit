# ── Zenith analytics ────────────────────────────────────────────────────────
# Copy to .env.local for local dev, or set these in your host's environment.
# NEVER commit real values for the bottom three — they are secrets.
#
# ZENITH_URL and ZENITH_SITE_KEY are public by design: both ship inside the
# tracking snippet on every page, and the site key can only WRITE events.
# They are read server-side (the <Analytics /> component renders on the
# server), so they need no NEXT_PUBLIC_ prefix.
#
# NOTE: ZENITH_PW_HASH contains "$" characters. In a .env FILE, wrap it in
# single quotes so Next's variable expansion doesn't eat them. In a hosting
# provider's env UI, paste it raw (no quotes).

ZENITH_URL=https://analytics.gritframework.dev
ZENITH_SITE_KEY=zk_the_public_site_key

# Secrets — server-side only. Never expose these to the browser.
ZENITH_API_KEY=zk_the_secret_api_key   # from the Zenith console → Setup tab
ZENITH_PW_HASH=                        # from: npx zenith hash
ZENITH_JWT_SECRET=                     # 32+ chars, e.g. openssl rand -base64 32
