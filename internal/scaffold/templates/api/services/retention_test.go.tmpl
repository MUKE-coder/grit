	"strings"
	"testing"
	"time"

	"github.com/glebarez/sqlite"
	"gorm.io/gorm"
	"gorm.io/gorm/logger"

	"{{MODULE}}/internal/files"
	"{{MODULE}}/internal/retention"
	"{{MODULE}}/internal/sync"
)

// retentionRow is a resource with a retention window and a file column, which
// is what a --retain resource with an attachment looks like.
type retentionRow struct {
	ID        string `gorm:"primarykey;size:36"`
	Body      string
	Image     *files.FileRef `gorm:"type:json"`
	CreatedAt time.Time
	DeletedAt gorm.DeletedAt `gorm:"index"`
}

func (retentionRow) TableName() string { return "retention_rows" }

const retentionDay = 24 * time.Hour

// The promise: rows past the window go, rows inside it stay, and the files the
// removed rows pointed at are handed to the orphan sweep.
func TestRetentionRemovesRowsPastTheWindowAndReleasesTheirFiles(t *testing.T) {
	db, svc := retentionFixture(t, retention.Policy{Model: &retentionRow{}, Window: 90 * retentionDay})

	for _, path := range []string{"uploads/old.webp", "uploads/young.webp"} {
		if err := db.Exec("INSERT INTO uploads (id, path, claimed_at) VALUES (?, ?, ?)",
			path, path, time.Now()).Error; err != nil {
			t.Fatal(err)
		}
	}
	rows := []retentionRow{
		{ID: "old", CreatedAt: time.Now().Add(-100 * retentionDay), Image: &files.FileRef{Key: "uploads/old.webp"}},
		{ID: "young", CreatedAt: time.Now().Add(-10 * retentionDay), Image: &files.FileRef{Key: "uploads/young.webp"}},
		{ID: "old-in-trash", CreatedAt: time.Now().Add(-100 * retentionDay)},
	}
	if err := db.Create(&rows).Error; err != nil {
		t.Fatal(err)
	}
	// Soft-deleted yesterday: still a row the policy promised to remove.
	if err := db.Delete(&retentionRow{}, "id = ?", "old-in-trash").Error; err != nil {
		t.Fatal(err)
	}

	out, err := svc.Sweep(context.Background())
	if err != nil {
		t.Fatalf("Sweep: %v", err)
	}
	if out["retention_rows"] != 2 {
		t.Errorf("removed %v, want the two rows older than the window", out)
	}

	var left []string
	if err := db.Unscoped().Model(&retentionRow{}).Pluck("id", &left).Error; err != nil {
		t.Fatal(err)
	}
	if len(left) != 1 || left[0] != "young" {
		t.Errorf("rows left after the sweep: %v, want only the one inside the window", left)
	}

	if isClaimed(t, db, "uploads/old.webp") {
		t.Error("the removed row's upload is still claimed, so the orphan sweep will never take the file")
	}
	if !isClaimed(t, db, "uploads/young.webp") {
		t.Error("released the upload of a row that is still inside its window")
	}
}

// A resource whose sweep cannot run must not keep every other resource's rows
// past their promise as well. It is reported, and the others still go.
func TestOneBrokenPolicyDoesNotStopTheRest(t *testing.T) {
	type unregistered struct {
		ID        string `gorm:"primarykey"`
		CreatedAt time.Time
	}
	type noCreatedAt struct {
		ID string `gorm:"primarykey"`
	}
	db, svc := retentionFixture(t,
		retention.Policy{Model: &unregistered{}, Window: retentionDay},
		retention.Policy{Model: &noCreatedAt{}, Window: retentionDay},
		retention.Policy{Model: &retentionRow{}, Window: retentionDay},
	)
	if err := db.Create(&retentionRow{ID: "old", CreatedAt: time.Now().Add(-2 * retentionDay)}).Error; err != nil {
		t.Fatal(err)
	}

	out, err := svc.Sweep(context.Background())
	if err == nil {
		t.Fatal("a model missing from the sync registry and one without created_at were swept without a word")
	}
	for _, want := range []string{"sync registry", "created_at"} {
		if !strings.Contains(err.Error(), want) {
			t.Errorf("the error does not say what is wrong (want %q): %v", want, err)
		}
	}
	if out["retention_rows"] != 1 {
		t.Errorf("removed %v: the broken policies stopped a working one", out)
	}
}

// A resource that has not been migrated yet has nothing in it to keep past a
// window, and a fresh deploy where the worker starts first is not a failure.
func TestATableNotYetMigratedIsSkipped(t *testing.T) {
	type pending struct {
		ID        string `gorm:"primarykey"`
		CreatedAt time.Time
	}
	_, svc := retentionFixture(t, retention.Policy{Model: &pending{}, Window: retentionDay})
	svc.Registry.Register("pendings", &pending{})

	if _, err := svc.Sweep(context.Background()); err != nil {
		t.Errorf("an unmigrated table failed the sweep: %v", err)
	}
}

func retentionFixture(t *testing.T, policies ...retention.Policy) (*gorm.DB, *RetentionService) {
	t.Helper()

	db, err := gorm.Open(sqlite.Open("file::memory:"), &gorm.Config{
		Logger: logger.Default.LogMode(logger.Silent),
	})
	if err != nil {
		t.Fatal(err)
	}
	// One connection: each :memory: connection is its own empty database.
	sqlDB, err := db.DB()
	if err != nil {
		t.Fatal(err)
	}
	sqlDB.SetMaxOpenConns(1)

	if err := db.AutoMigrate(&retentionRow{}); err != nil {
		t.Fatal(err)
	}
	if err := db.Exec(`CREATE TABLE uploads (
		id TEXT PRIMARY KEY, path TEXT, derived TEXT,
		claimed_at DATETIME, created_at DATETIME
	)`).Error; err != nil {
		t.Fatal(err)
	}

	registry := &sync.Registry{}
	registry.Register("retention_rows", &retentionRow{})
	return db, &RetentionService{
		DB:       db,
		Registry: registry,
		Policies: func() []retention.Policy { return policies },
	}
}
