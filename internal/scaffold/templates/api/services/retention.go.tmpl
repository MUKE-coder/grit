package services

import (
	"context"
	"errors"
	"fmt"
	"regexp"
	"time"

	"gorm.io/gorm"

	"{{MODULE}}/internal/retention"
	"{{MODULE}}/internal/sync"
)

// RetentionService enforces the windows resources declared with --retain:
// rows created longer ago than their window are removed for good (grit#260).
//
// The removing is TrashService.purge, deliberately. It already pages through
// the rows, deletes exactly the ones it read, and releases each row's uploads
// to the orphan sweep, which takes the renditions and the kept original with
// them and spares a file another record still points at. A second copy of
// that loop here would be a second place for those rules to drift, and the
// copy that drifts costs somebody a file (see files.ReleaseRefs).
//
// The price is the one the Trash already pays: the files go on the orphan
// sweep's next pass, within a day, rather than in this one. Erasure is the
// path that cannot wait, and it deletes immediately.
type RetentionService struct {
	DB       *gorm.DB
	Registry *sync.Registry

	// Policies is where the windows come from. Nil means the ones the models
	// registered; a test sets it so it does not depend on the global registry.
	Policies func() []retention.Policy
}

// Sweep removes every row past its resource's window and returns how many
// went, per table.
//
// Unscoped, through purge: a row already in the Trash is still a row the
// policy promised to remove, so being soft-deleted yesterday does not buy it
// another thirty days.
//
// One table failing does not stop the others. A resource whose sweep breaks
// should not keep every other resource's data past its promise too, so the
// failures are collected and returned together, and the job reports them.
func (s *RetentionService) Sweep(ctx context.Context) (map[string]int64, error) {
	if s.Registry == nil {
		return nil, fmt.Errorf("no resource registry: the retention sweep cannot read any table")
	}
	list := retention.Policies
	if s.Policies != nil {
		list = s.Policies
	}

	trash := &TrashService{DB: s.DB, Registry: s.Registry}
	out := map[string]int64{}
	var errs []error
	for _, p := range list() {
		table, err := s.table(ctx, p.Model)
		if err != nil {
			errs = append(errs, err)
			continue
		}
		if table == "" {
			continue
		}
		cutoff := time.Now().Add(-p.Window)

		// This resource's tables are resolved before any of its rows are
		// deleted. A record whose lines cannot be read would be refused by the
		// database anyway, and trying reports the same failure twice.
		var lines []retentionLines
		linesFailed := false
		for _, l := range p.Lines {
			lineTable, err := s.lineTable(ctx, l, table)
			if err != nil {
				errs = append(errs, fmt.Errorf("sweeping the lines of %s: %w", table, err))
				linesFailed = true
				continue
			}
			if lineTable != "" {
				lines = append(lines, retentionLines{table: lineTable, foreignKey: l.ForeignKey})
			}
		}
		if linesFailed {
			continue
		}
		// The leaf query names parent_id, the column --tree writes. A model
		// without one would fail as SQL every night with an error that does
		// not say why, the same as a missing created_at.
		if p.Tree && !s.hasColumn(p.Model, "parent_id") {
			errs = append(errs, fmt.Errorf("%s is retained as a tree but has no parent_id column", table))
			continue
		}
		if err := s.sweepTable(ctx, trash, table, p.Tree, lines, cutoff, out); err != nil {
			errs = append(errs, fmt.Errorf("sweeping %s: %w", table, err))
		}
	}
	return out, errors.Join(errs...)
}

// retentionLines is a record's lines, resolved to the table purge works on.
type retentionLines struct {
	table, foreignKey string
}

// maxTreeDepth bounds the passes a tree takes. Each pass removes the expired
// leaves, which can make their parents leaves, so a tree needs one pass per
// level; this is far deeper than any category tree, and only stops a loop that
// something unforeseen keeps feeding.
const maxTreeDepth = 1000

// retentionPage is how many rows with lines go in one transaction: the same
// page purge reads, so a transaction holds its locks for one page at most.
const retentionPage = 500

// sweepTable removes the rows of one table that are due, with their lines,
// and counts what went into out.
//
// Due is past the window, and on a tree also a leaf: only a node nothing
// points at goes, so a parent stays while any child is younger than the
// window, and the paths of the nodes that stay never name a node that went.
// Removing the leaves can make their parents leaves, so a tree repeats until
// nothing is due.
func (s *RetentionService) sweepTable(ctx context.Context, trash *TrashService, table string, tree bool,
	lines []retentionLines, cutoff time.Time, out map[string]int64) error {
	due := "created_at < ?"
	if tree {
		due += " AND NOT EXISTS (SELECT 1 FROM " + table +
			" AS retention_child WHERE retention_child.parent_id = " + table + ".id)"
	}
	if len(lines) > 0 {
		return s.sweepWithLines(ctx, table, lines, due, cutoff, out)
	}

	if !tree {
		n, err := trash.purge(ctx, table, due, cutoff)
		retentionCount(out, table, n)
		return err
	}
	for i := 0; i < maxTreeDepth; i++ {
		n, err := trash.purge(ctx, table, due, cutoff)
		retentionCount(out, table, n)
		if err != nil || n == 0 {
			return err
		}
	}
	// Said rather than returned quietly: rows past their window are still
	// there, and the policy says they are not.
	return fmt.Errorf("%s still had rows to remove after %d passes", table, maxTreeDepth)
}

// sweepWithLines removes due rows and their lines a page at a time, each page
// in one transaction: the rows are picked by id, their lines go, then exactly
// those rows.
//
// A line goes when its record goes, whatever its own age: an invoice line is
// saved a moment after its invoice and would otherwise outlive it by a night,
// and a tree node kept for its children keeps its lines with it. The lines are
// first because the database refuses a record while they remain.
//
// One transaction, so the two cannot come apart. A line or a child added to a
// due row while the page runs makes the database refuse that row, and the
// page's lines are put back with it rather than lost from a record that stays.
// The page is tried again the next night. The Trash's purge runs unchanged
// inside it, its file releases included, because it works on whatever handle
// it is given.
func (s *RetentionService) sweepWithLines(ctx context.Context, table string, lines []retentionLines,
	due string, cutoff time.Time, out map[string]int64) error {
	for {
		removed := map[string]int64{}
		err := s.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
			var ids []string
			if err := tx.Table(table).Where(due, cutoff).Order("id").Limit(retentionPage).
				Pluck("id", &ids).Error; err != nil {
				return err
			}
			if len(ids) == 0 {
				return nil
			}
			trash := &TrashService{DB: tx, Registry: s.Registry}
			for _, l := range lines {
				n, err := trash.purge(ctx, l.table, l.foreignKey+" IN ?", ids)
				removed[l.table] += n
				if err != nil {
					return fmt.Errorf("the lines in %s: %w", l.table, err)
				}
			}
			n, err := trash.purge(ctx, table, "id IN ?", ids)
			removed[table] += n
			if err != nil {
				return err
			}
			// Every page has to remove something, or the loop would read the
			// same page for ever.
			if n == 0 {
				return fmt.Errorf("%d rows were due and none could be removed", len(ids))
			}
			return nil
		})
		if err != nil {
			return err
		}
		// Counted once committed, so a page that was rolled back is not
		// reported as removed.
		for name, n := range removed {
			retentionCount(out, name, n)
		}
		if removed[table] == 0 {
			return nil
		}
	}
}

// retentionCount adds n to what the sweep reports for a table. A table that
// lost nothing is left out, so the job can say "nothing past its window".
func retentionCount(out map[string]int64, table string, n int64) {
	if n > 0 {
		out[table] += n
	}
}

// hasColumn reports whether model has the column, by its database name.
func (s *RetentionService) hasColumn(model interface{}, column string) bool {
	stmt := &gorm.Statement{DB: s.DB}
	return stmt.Parse(model) == nil && stmt.Schema.LookUpField(column) != nil
}

// retentionIdentifier is what a table or column name has to look like before
// it goes into the SQL above. Both come from the models, not from a request,
// and this is what keeps it that way.
var retentionIdentifier = regexp.MustCompile("^[a-z_][a-z0-9_]*$")

// lineTable resolves a record's lines to the table purge works on, or "" when
// it has not been migrated, in which case there are no lines to remove.
func (s *RetentionService) lineTable(ctx context.Context, l retention.Lines, record string) (string, error) {
	stmt := &gorm.Statement{DB: s.DB}
	if err := stmt.Parse(l.Model); err != nil {
		return "", fmt.Errorf("resolving %T: %w", l.Model, err)
	}
	table := stmt.Schema.Table
	if !retentionIdentifier.MatchString(l.ForeignKey) || stmt.Schema.LookUpField(l.ForeignKey) == nil {
		return "", fmt.Errorf("%s has no column %q pointing at %s", table, l.ForeignKey, record)
	}
	if _, err := s.Registry.New(table); err != nil {
		return "", fmt.Errorf("%s holds the lines of %s but is not in the sync registry, "+
			"so the sweep cannot read it: register it in routes.go", table, record)
	}
	if !s.DB.WithContext(ctx).Migrator().HasTable(table) {
		return "", nil
	}
	return table, nil
}

// table resolves a registered model to the table purge works on, or "" when
// the table has not been migrated yet, which is not an error: there is nothing
// in it to keep past a window.
func (s *RetentionService) table(ctx context.Context, model interface{}) (string, error) {
	stmt := &gorm.Statement{DB: s.DB}
	if err := stmt.Parse(model); err != nil {
		return "", fmt.Errorf("resolving %T: %w", model, err)
	}
	table := stmt.Schema.Table
	if !retentionIdentifier.MatchString(table) {
		return "", fmt.Errorf("%q is not a table name the sweep will write into SQL", table)
	}

	// The window is measured from created_at. A model without one would fail
	// as SQL every night with an error that does not say why.
	if stmt.Schema.LookUpField("created_at") == nil {
		return "", fmt.Errorf("%s has a retention window but no created_at column to measure it from", table)
	}
	// purge reads rows through the sync registry. A resource missing from it
	// would be skipped with nothing said, and its rows kept past the promise.
	if _, err := s.Registry.New(table); err != nil {
		return "", fmt.Errorf("%s has a retention window but is not in the sync registry, "+
			"so the sweep cannot read it: register it in routes.go", table)
	}
	if !s.DB.WithContext(ctx).Migrator().HasTable(table) {
		return "", nil
	}
	return table, nil
}
