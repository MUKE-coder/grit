package handlers

import (
	"bytes"
	"encoding/json"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/gin-gonic/gin"
	"github.com/glebarez/sqlite"
	"gorm.io/gorm"
	"gorm.io/gorm/logger"

	"{{MODULE}}/internal/dbtx"
)

// A table the batch writes into, standing in for a resource. The point of
// these tests is the transaction and the replay, not any particular model.
type batchRow struct {
	ID   string `gorm:"primaryKey" json:"id"`
	Name string `json:"name"`
}

func (batchRow) TableName() string { return "batch_rows" }

// batchApp is a router with two routes: one that writes, and one that refuses.
//
// Built here rather than using the real one so the test says what it is
// testing. The write goes through database.TxFrom exactly as a generated
// service does, which is the part that has to work.
func batchApp(t *testing.T) (*gin.Engine, *gorm.DB) {
	t.Helper()
	gin.SetMode(gin.TestMode)

	db, err := gorm.Open(sqlite.Open(":memory:"), &gorm.Config{
		Logger: logger.Default.LogMode(logger.Silent),
	})
	if err != nil {
		t.Fatal(err)
	}
	sqlDB, err := db.DB()
	if err != nil {
		t.Fatal(err)
	}
	// One connection: a second to ":memory:" is a second, empty database,
	// and a transaction on one would be invisible to the other.
	sqlDB.SetMaxOpenConns(1)
	t.Cleanup(func() { _ = sqlDB.Close() })

	if err := db.AutoMigrate(&batchRow{}); err != nil {
		t.Fatal(err)
	}

	r := gin.New()
	api := r.Group("/api/v1")

	api.POST("/batch-rows", func(c *gin.Context) {
		var row batchRow
		if err := c.ShouldBindJSON(&row); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": gin.H{"message": err.Error()}})
			return
		}
		// The handle a generated service would use.
		handle := db
		if tx := dbtx.TxFrom(c.Request.Context()); tx != nil {
			handle = tx
		}
		if err := handle.Create(&row).Error; err != nil {
			c.JSON(http.StatusInternalServerError, gin.H{"error": gin.H{"message": err.Error()}})
			return
		}
		c.JSON(http.StatusCreated, gin.H{"data": row})
	})

	api.POST("/always-refuses", func(c *gin.Context) {
		c.JSON(http.StatusUnprocessableEntity, gin.H{
			"error": gin.H{"code": "VALIDATION_ERROR", "message": "no"},
		})
	})

	r.POST("/api/v1/batch", NewBatchHandler(db, r).Execute)
	return r, db
}

func postBatch(t *testing.T, r *gin.Engine, body string) *httptest.ResponseRecorder {
	t.Helper()
	req := httptest.NewRequest("POST", "/api/v1/batch", bytes.NewReader([]byte(body)))
	req.Header.Set("Content-Type", "application/json")
	rec := httptest.NewRecorder()
	r.ServeHTTP(rec, req)
	return rec
}

func rowCount(t *testing.T, db *gorm.DB) int64 {
	t.Helper()
	var n int64
	if err := db.Model(&batchRow{}).Count(&n).Error; err != nil {
		t.Fatal(err)
	}
	return n
}

func TestABatchWritesEverythingOrNothing(t *testing.T) {
	r, db := batchApp(t)

	body := `{"requests":[
		{"method":"POST","url":"/api/v1/batch-rows","body":{"id":"r1","name":"one"}},
		{"method":"POST","url":"/api/v1/batch-rows","body":{"id":"r2","name":"two"}},
		{"method":"POST","url":"/api/v1/batch-rows","body":{"id":"r3","name":"three"}}
	]}`
	rec := postBatch(t, r, body)
	if rec.Code != http.StatusOK {
		t.Fatalf("a batch of three writes answered %d: %s", rec.Code, rec.Body.String())
	}
	if n := rowCount(t, db); n != 3 {
		t.Errorf("%d rows were written, want 3", n)
	}

	var out struct {
		Data []BatchResult `json:"data"`
	}
	if err := json.Unmarshal(rec.Body.Bytes(), &out); err != nil {
		t.Fatal(err)
	}
	if len(out.Data) != 3 {
		t.Fatalf("got %d results, want 3", len(out.Data))
	}
	for i, result := range out.Data {
		if result.Status != http.StatusCreated {
			t.Errorf("result %d is %d, want 201", i+1, result.Status)
		}
	}
}

// The one that matters. A batch that half happened is the state the caller
// used a batch to avoid.
func TestAFailureRollsBackTheWholeBatch(t *testing.T) {
	r, db := batchApp(t)

	body := `{"requests":[
		{"method":"POST","url":"/api/v1/batch-rows","body":{"id":"r1","name":"one"}},
		{"method":"POST","url":"/api/v1/batch-rows","body":{"id":"r2","name":"two"}},
		{"method":"POST","url":"/api/v1/always-refuses","body":{}},
		{"method":"POST","url":"/api/v1/batch-rows","body":{"id":"r4","name":"four"}}
	]}`
	rec := postBatch(t, r, body)

	if rec.Code != http.StatusUnprocessableEntity {
		t.Errorf("a failed batch answered %d, want 422: %s", rec.Code, rec.Body.String())
	}
	if n := rowCount(t, db); n != 0 {
		t.Errorf("%d rows survived a batch that failed; the transaction did not roll back", n)
	}

	// The caller has to be told which one failed, or they are guessing.
	var out struct {
		Error struct {
			Message string         `json:"message"`
			Details map[string]any `json:"details"`
		} `json:"error"`
		Data []BatchResult `json:"data"`
	}
	if err := json.Unmarshal(rec.Body.Bytes(), &out); err != nil {
		t.Fatal(err)
	}
	if idx, ok := out.Error.Details["failed_index"].(float64); !ok || int(idx) != 2 {
		t.Errorf("the response does not say request 3 failed: %v", out.Error.Details)
	}
	if len(out.Data) != 3 {
		t.Errorf("got %d results, want the three that ran", len(out.Data))
	}
	if len(out.Data) == 3 && out.Data[2].Status != http.StatusUnprocessableEntity {
		t.Errorf("the failing result is %d", out.Data[2].Status)
	}
}

func TestABatchCannotContainABatch(t *testing.T) {
	r, _ := batchApp(t)
	rec := postBatch(t, r, `{"requests":[{"method":"POST","url":"/api/v1/batch","body":{"requests":[]}}]}`)

	// The nested one is refused by the marker header, so the outer batch
	// fails rather than recursing.
	if rec.Code == http.StatusOK {
		t.Error("a batch containing a batch succeeded")
	}
}

func TestABatchOnlyReachesThisAPI(t *testing.T) {
	r, db := batchApp(t)

	for _, url := range []string{
		"https://example.com/webhook",
		"/etc/passwd",
		"/api/../admin",
		"//evil.example/api/v1/batch-rows",
	} {
		body := `{"requests":[{"method":"POST","url":"` + url + `","body":{}}]}`
		rec := postBatch(t, r, body)
		if rec.Code != http.StatusUnprocessableEntity {
			t.Errorf("%s answered %d, want a refusal", url, rec.Code)
		}
	}

	// Refused before anything ran, so a bad entry does not roll back work
	// that had already succeeded.
	if n := rowCount(t, db); n != 0 {
		t.Errorf("%d rows were written by a batch that should not have started", n)
	}
}

func TestABatchIsCapped(t *testing.T) {
	r, _ := batchApp(t)

	var sb bytes.Buffer
	sb.WriteString(`{"requests":[`)
	for i := 0; i <= MaxBatchRequests; i++ {
		if i > 0 {
			sb.WriteString(",")
		}
		sb.WriteString(`{"method":"POST","url":"/api/v1/batch-rows","body":{}}`)
	}
	sb.WriteString(`]}`)

	rec := postBatch(t, r, sb.String())
	if rec.Code != http.StatusUnprocessableEntity {
		t.Errorf("a batch of %d answered %d, want a refusal", MaxBatchRequests+1, rec.Code)
	}

	// And an empty one, which is a mistake rather than a no-op.
	if rec := postBatch(t, r, `{"requests":[]}`); rec.Code != http.StatusUnprocessableEntity {
		t.Errorf("an empty batch answered %d", rec.Code)
	}
}

// A sub-request must not be able to say who it is. Otherwise a batch
// authenticated as one person carries a request authenticated as another.
func TestASubRequestCannotSetItsOwnIdentity(t *testing.T) {
	for _, name := range []string{"Authorization", "Cookie", "authorization", "COOKIE"} {
		if !isReservedBatchHeader(name) {
			t.Errorf("%s can be set by a sub-request", name)
		}
	}
	// And an ordinary header still can, or the feature is useless.
	if isReservedBatchHeader("X-Idempotency-Key") {
		t.Error("an ordinary header was refused")
	}
}
