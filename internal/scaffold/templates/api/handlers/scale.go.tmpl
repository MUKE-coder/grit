package handlers

import (
	"fmt"
	"net/http"
	"os"
	"runtime"
	"strconv"
	"strings"

	"github.com/gin-gonic/gin"
	"gorm.io/gorm"
	gormlogger "gorm.io/gorm/logger"

	"{{MODULE}}/internal/cache"
	"{{MODULE}}/internal/database"
	"{{MODULE}}/internal/middleware"
