// POST /api/v1/batch: many writes, one transaction.
//
// A client creating an order and its six lines makes seven requests today,
// and if the fourth fails it has four rows it has to clean up itself, over a
// connection that may already have gone. The only honest answer is a
// transaction, and a transaction cannot span seven requests.
//
//	POST /api/v1/batch
//	{
//	  "requests": [
//	    {"method": "POST",  "url": "/api/v1/orders",       "body": {"customer_id": "c1"}},
//	    {"method": "POST",  "url": "/api/v1/order-lines",  "body": {"sku": "A", "qty": 2}},
//	    {"method": "PATCH", "url": "/api/v1/stock/s1",     "body": {"on_hand": 8}}
//	  ]
//	}
//
// Every one of them is replayed through this application's own router, so a
// batch can only do what the caller could have done one request at a time:
// the same routes, the same permissions, the same row rules, the same
// validation. There is no second code path to keep in step, which is the
// whole design.

// MaxBatchRequests caps one batch.
//
// Each sub-request is a full pass through the router, and they all hold one
// transaction open while they run. Fifty is a large order with its lines; a
// thousand is an import, and an import has its own endpoint that streams.
const MaxBatchRequests = 50

// BatchTimeout is how long the whole batch may take. See Execute for why a
// batch that overruns it is a bug report rather than a slow request.
const BatchTimeout = 30 * time.Second

// BatchHandler replays a batch's requests through the router that owns it.
type BatchHandler struct {
	DB *gorm.DB

	// engine is this application's router. Captured when the route is
	// registered, after everything else is mounted, because a batch is only
	// allowed to reach routes that exist.
	engine *gin.Engine
}

// NewBatchHandler returns a handler bound to the router it will replay into.
func NewBatchHandler(db *gorm.DB, engine *gin.Engine) *BatchHandler {
	return &BatchHandler{DB: db, engine: engine}
}

// BatchRequest is one call inside a batch.
type BatchRequest struct {
	Method string            `json:"method"`
	URL    string            `json:"url"`
	Body   json.RawMessage   `json:"body,omitempty"`
	Header map[string]string `json:"headers,omitempty"`
}

// BatchResult is what one call answered.
type BatchResult struct {
	Status int             `json:"status"`
	Body   json.RawMessage `json:"body,omitempty"`
}

type batchPayload struct {
	Requests []BatchRequest `json:"requests"`
}

// batchHeader marks a replayed request, so a batch cannot contain a batch.
//
// Without it, one request nests fifty, each of which nests fifty, and the
// stack is gone before the transaction is.
const batchHeader = "X-Grit-Batch"

// Execute runs every request in one transaction.
//
// All of them commit or none do. A sub-request answering 400 or above rolls
// the whole thing back, because a batch that half happened is the state the
// caller used a batch to avoid.
func (h *BatchHandler) Execute(c *gin.Context) {
	if c.GetHeader(batchHeader) != "" {
		respond.Fail(c, respond.CodeBadRequest, "A batch cannot contain another batch.")
		return
	}

	var payload batchPayload
	if err := c.ShouldBindJSON(&payload); err != nil {
		respond.Fail(c, respond.CodeValidationError, "This batch is not readable: "+err.Error())
		return
	}
	if len(payload.Requests) == 0 {
		respond.Fail(c, respond.CodeValidationError, "A batch needs at least one request.")
		return
	}
	if len(payload.Requests) > MaxBatchRequests {
		respond.Fail(c, respond.CodeValidationError, fmt.Sprintf(
			"A batch holds at most %d requests, and this one has %d.",
			MaxBatchRequests, len(payload.Requests)))
		return
	}

	for i, req := range payload.Requests {
		if err := validBatchRequest(req); err != nil {
			respond.Fail(c, respond.CodeValidationError, fmt.Sprintf("Request %d: %s", i+1, err))
			return
		}
	}

	// A deadline on the whole batch, and it is a safety net rather than a
	// policy.
	//
	// A batch holds a transaction, and on SQLite that is the only connection
	// the process has. Anything inside a replayed request that asks the pool
	// for a second one does not get an error: it waits, and the request hangs
	// until the client gives up, while the connection stays held and every
	// later request queues behind it. One missed call site takes the server
	// down and nothing in the log says why.
	//
	// With a deadline the same mistake is a 503 in thirty seconds with the
	// batch in the message, which is a bug report rather than a mystery.
	ctx, cancel := context.WithTimeout(c.Request.Context(), BatchTimeout)
	defer cancel()

	results := make([]BatchResult, len(payload.Requests))
	var failed int = -1

	err := h.DB.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
		for i, req := range payload.Requests {
			result, err := h.replay(ctx, c, tx, req)
			if err != nil {
				return err
			}
			results[i] = result
			if result.Status >= http.StatusBadRequest {
				failed = i
				// A sentinel, so the transaction rolls back and the loop
				// stops. The results gathered so far are still reported,
				// because the caller needs to know which one failed and why.
				return errBatchFailed
			}
		}
		return nil
	})

	if err != nil && err != errBatchFailed {
		if errors.Is(err, context.DeadlineExceeded) {
			respond.Fail(c, respond.CodeInternalError, fmt.Sprintf(
				"This batch did not finish within %s and nothing was saved. "+
					"A request inside it is waiting for a database connection the batch itself is holding.",
				BatchTimeout))
			return
		}
		respond.ServerError(c, "INTERNAL_ERROR", err, "This batch could not be run.")
		return
	}

	if failed >= 0 {
		c.JSON(http.StatusUnprocessableEntity, gin.H{
			"error": gin.H{
				"code": string(respond.CodeValidationError),
				"message": fmt.Sprintf(
					"Request %d of %d failed, so nothing was saved.", failed+1, len(payload.Requests)),
				"details": gin.H{"failed_index": failed},
			},
			"data": results[:failed+1],
		})
		return
	}

	c.JSON(http.StatusOK, gin.H{"data": results})
}

var errBatchFailed = fmt.Errorf("a request in this batch failed")

// replay sends one sub-request through the router, inside the transaction.
func (h *BatchHandler) replay(ctx context.Context, outer *gin.Context, tx *gorm.DB, req BatchRequest) (BatchResult, error) {
	var body *bytes.Reader
	if len(req.Body) > 0 {
		body = bytes.NewReader(req.Body)
	} else {
		body = bytes.NewReader(nil)
	}

	inner := httptest.NewRequest(strings.ToUpper(req.Method), req.URL, body)

	// The caller's own identity, and nothing they did not send. Copying the
	// whole header would let a sub-request carry its own Authorization and
	// act as somebody else inside a batch that authenticated as this person.
	for _, name := range []string{"Authorization", "Cookie", "Accept-Language", "X-Organization-Id"} {
		if v := outer.GetHeader(name); v != "" {
			inner.Header.Set(name, v)
		}
	}
	for name, value := range req.Header {
		// Only headers that cannot change who the caller is.
		if isReservedBatchHeader(name) {
			continue
		}
		inner.Header.Set(name, value)
	}
	inner.Header.Set("Content-Type", "application/json")
	inner.Header.Set(batchHeader, "1")
	inner.RemoteAddr = outer.Request.RemoteAddr

	// The transaction, and the outer request's cancellation. Everything
	// downstream that reads database.TxFrom writes inside this.
	inner = inner.WithContext(dbtx.WithTx(ctx, tx))

	recorder := httptest.NewRecorder()
	h.engine.ServeHTTP(recorder, inner)

	result := BatchResult{Status: recorder.Code}
	if raw := recorder.Body.Bytes(); len(raw) > 0 && json.Valid(raw) {
		result.Body = json.RawMessage(raw)
	}
	return result, nil
}

// validBatchRequest refuses what cannot be replayed before anything runs, so
// a malformed entry does not roll back work that had already succeeded.
func validBatchRequest(req BatchRequest) error {
	switch strings.ToUpper(req.Method) {
	case http.MethodPost, http.MethodPut, http.MethodPatch, http.MethodDelete, http.MethodGet:
	default:
		return fmt.Errorf("%q is not a method a batch can send", req.Method)
	}

	// This application's own API and nothing else. Without the check a batch
	// is a request forger: the server would follow an absolute URL, with the
	// caller's cookies, from inside the network.
	if !strings.HasPrefix(req.URL, "/api/") {
		return fmt.Errorf("%q is not a path on this API; a batch sends /api/... and nothing else", req.URL)
	}
	if strings.Contains(req.URL, "//") || strings.Contains(req.URL, "..") {
		return fmt.Errorf("%q is not a path this API serves", req.URL)
	}
	return nil
}

func isReservedBatchHeader(name string) bool {
	switch strings.ToLower(name) {
	case "authorization", "cookie", "host", "content-length", strings.ToLower(batchHeader):
		return true
	}
	return false
}
