import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { createVideo, getVideo, isConverting, type Video } from "@/lib/video";

/**
 * One video, refetched every two seconds while it converts and not at all
 * once it is ready or has failed.
 */
export function useVideo(id: string | undefined) {
  return useQuery<Video>({
    queryKey: ["videos", id],
    queryFn: () => getVideo(id as string),
    enabled: !!id,
    refetchInterval: (query) => (isConverting(query.state.data) ? 2000 : false),
  });
}

/** Queues an uploaded clip for conversion and seeds its cache entry. */
export function useCreateVideo() {
  const queryClient = useQueryClient();
  return useMutation({
    mutationFn: (key: string) => createVideo(key),
    onSuccess: (video) => {
      queryClient.setQueryData(["videos", video.id], video);
    },
  });
}
