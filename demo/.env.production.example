# ============================================
# Grit Motors — Production Environment Variables
# ============================================
#
# EXAMPLE FILE — every value below is a placeholder. Copy it to
# `.env.production` (which is gitignored) and fill in real values there.
# Never commit real credentials to this file.
#
# Generate strong secrets with:  openssl rand -hex 32

# App
APP_NAME=Grit Motors
APP_ENV=production
APP_PORT=8080
APP_URL=https://your-domain.example.com
FRONTEND_URL=https://your-domain.example.com

# Database — PostgreSQL (docker-compose service)
# Must match POSTGRES_PASSWORD at the bottom of this file.
DATABASE_URL=postgres://grit:CHANGE_ME_db_password@postgres:5432/grit?sslmode=disable

# JWT — openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=720h

# Internal API Key — openssl rand -hex 16
INTERNAL_API_KEY=CHANGE_ME_internal_api_key

# Storage — Cloudflare R2
STORAGE_DRIVER=r2
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=CHANGE_ME_r2_access_key
R2_SECRET_KEY=CHANGE_ME_r2_secret_key
R2_BUCKET=your-bucket-name
R2_REGION=auto

# Email — Resend
RESEND_API_KEY=re_CHANGE_ME
MAIL_FROM=noreply@your-domain.example.com

# Redis (docker-compose service)
# Must match REDIS_PASSWORD at the bottom of this file.
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379

# CORS
CORS_ORIGINS=https://your-domain.example.com

# GORM Studio
GORM_STUDIO_ENABLED=false
GORM_STUDIO_USERNAME=admin
GORM_STUDIO_PASSWORD=CHANGE_ME_studio_password

# ============================================
# Monitoring — Sentinel (security) + Pulse (observability)
# ============================================
# Both refuse to start in production with default credentials. You have two
# options:
#   (a) Set non-default values for every *_USERNAME / *_PASSWORD / *_SECRET_KEY
#       below, OR
#   (b) Set DEMO_MODE=true (further down) — this is what the public Grit demo
#       does, since the dashboards are intentionally publicly accessible.
# Generate strong secrets with:  openssl rand -hex 32
PULSE_ENABLED=true
PULSE_USERNAME=admin
PULSE_PASSWORD=CHANGE_ME_pulse_strong_password
PULSE_STORAGE=sqlite
PULSE_STORAGE_DSN=/data/pulse.db

SENTINEL_ENABLED=true
SENTINEL_USERNAME=admin
SENTINEL_PASSWORD=CHANGE_ME_sentinel_strong_password
SENTINEL_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
# Comma-separated CIDRs trusted to set X-Forwarded-For. Set to your load
# balancer / reverse-proxy subnet. Leave empty to trust no proxies.
SENTINEL_TRUSTED_PROXIES=

# ============================================
# Demo mode
# ============================================
# When true:
#   - admin@grit.demo / demo123 is auto-seeded on boot
#   - canonical demo cohort (staff, products, motorcycles, loans, sales) is seeded
#   - nightly cron at 03:00 UTC wipes mutable data and reseeds
#   - Resend email sending is disabled (no real emails go out)
#   - Sentinel + Pulse skip their production-credentials gate
# Leave OFF for real production deploys.
DEMO_MODE=false

# DGateway (Desispay) — mobile money collections for loan repayments
DGATEWAY_API_KEY=dgw_live_REPLACE_THIS
DGATEWAY_BASE_URL=
DGATEWAY_DEFAULT_PROVIDER=iotec

# Frontend build-time env vars (MUST match INTERNAL_API_KEY)
VITE_INTERNAL_API_KEY=CHANGE_ME_internal_api_key
VITE_APP_NAME=Grit Motors

# Docker Compose passwords (used by postgres/redis services)
POSTGRES_PASSWORD=CHANGE_ME_db_password
REDIS_PASSWORD=CHANGE_ME_redis_password
