{
  "name": "@commerce/admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "//dev": "--webpack is a workaround for an upstream Turbopack bug: its Google-fonts loader fails to resolve its own @vercel/turbopack-next/internal/font/google/font module, and the app never renders (grit#77). It does not reproduce on every machine, which is why it survived so long. Remove the flag once Turbopack ships the fix and dev gets faster again.",
    "dev": "rm -rf .next && next dev --webpack --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --formatter-enabled=false .",
    "format": "biome format --write .",
    "analyze": "ANALYZE=true next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "libphonenumber-js": "^1.13.13",
    "@hookform/resolvers": "^3.3.0",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.1.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "react-dropzone": "^14.2.0",
    "react-hook-form": "^7.49.0",
    "recharts": "^2.12.0",
    "sonner": "^1.3.0",
    "tailwind-merge": "^2.2.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "@react-pdf/renderer": "^4.1.5",
    "zod": "^3.22.0",
    "@repo/shared": "workspace:*",
    "@repo/upload": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
